---
import { InstrumentGraphic } from "./instrument-graphic";
import type { InstrumentGraphicProps } from "./instrument-graphic";

interface Props extends Omit<InstrumentGraphicProps, "className" | "title" | "decorative"> {
  href: string;
  title: string;
  description?: string;
  /** Short real-data label, e.g. "18 prompts". */
  meta?: string;
  class?: string;
}

const { href, title, description, meta, class: className, ...plate } = Astro.props;
---

<a href={href} class:list={["plate-link", className]}>
  <span class="plate-link__frame">
    <InstrumentGraphic {...plate} decorative />
  </span>
  <span class="plate-link__caption">
    <span class="plate-link__title">{title}</span>
    {meta && <span class="technical-label plate-link__meta">{meta}</span>}
    {description && <span class="plate-link__desc">{description}</span>}
  </span>
</a>
