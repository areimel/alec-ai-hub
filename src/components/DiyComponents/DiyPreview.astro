---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Container from "@components/container.astro";
import SectionHead from "@components/SectionHead.astro";
import directoryShot from "@assets/diy/directory.webp";
import detailShot from "@assets/diy/detail.webp";

type ShotKey = "directory" | "detail";

export interface Props {
  content: {
    header: { label: string; title: string };
    shots: { key: ShotKey; caption: string; code: string; alt: string }[];
  };
}

const { content } = Astro.props;

// Captured by scripts/capture-diy-previews.mjs; widths match the 1440px source.
const sources: Record<ShotKey, { src: ImageMetadata; widths: number[]; sizes: string }> = {
  directory: {
    src: directoryShot,
    widths: [640, 960, 1280, 1440],
    sizes: "(min-width: 1100px) 66vw, 100vw",
  },
  detail: {
    src: detailShot,
    widths: [320, 480, 640, 960],
    sizes: "(min-width: 1100px) 36vw, 80vw",
  },
};
---

<section class="home-section">
  <Container>
    <SectionHead label={content.header.label} title={content.header.title} />
    <div class="diy-preview">
      {
        content.shots.map((shot) => {
          const source = sources[shot.key];
          return (
            <figure class={`diy-preview__figure diy-preview__figure--${shot.key}`}>
              <div class="diy-preview__frame">
                <div class="diy-preview__bar">
                  <span class="registration-mark" aria-hidden="true" />
                  <span class="technical-label diy-preview__code">{shot.code}</span>
                </div>
                <Image
                  src={source.src}
                  alt={shot.alt}
                  widths={source.widths}
                  sizes={source.sizes}
                  loading="lazy"
                  class="diy-preview__image"
                />
              </div>
              <figcaption class="diy-preview__caption">{shot.caption}</figcaption>
            </figure>
          );
        })
      }
    </div>
  </Container>
</section>
