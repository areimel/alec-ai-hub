---
import ActionButton from "@components/ui/ActionButton.astro";
import FormField from "./FormField.astro";

const categories = ["Coding", "Writing", "Creative", "Analysis", "Marketing", "Other"];
const platforms = ["ChatGPT", "Claude", "Cursor", "MidJourney", "Other"];
---

<!-- Submissions go to Alec's inbox through web3forms. Without JS the form posts to `action` directly. -->
<form action="https://api.web3forms.com/submit" method="POST" id="promptSubmissionForm" class="hub-form">
  <input type="hidden" name="access_key" value="75f8b211-81aa-45c2-9c7b-c11f447d30a0" />
  <input type="hidden" name="subject" value="New AI Prompt Submission" />
  <input type="hidden" name="from_name" value="Company AI Prompts - Submission Form" />
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

  <FormField id="prompt-submitter-name" name="submitter_name" label="Your name" autocomplete="name" required error="Enter your name." />
  <FormField id="prompt-submitter-email" name="submitter_email" label="Your email address" type="email" autocomplete="email" required error="Enter an email address in the form name@example.com." />
  <FormField id="prompt-title" name="prompt_title" label="Prompt title" required error="Give the prompt a title." />
  <FormField id="prompt-description" name="prompt_description" label="What it does" control="textarea" rows={3} required error="Describe what the prompt does." />
  <FormField id="prompt-category" name="prompt_category" label="Category" control="select" options={categories} prompt="Select a category" required error="Select a category." />
  <FormField id="prompt-platform" name="prompt_sub_category" label="AI platform" control="select" options={platforms} prompt="Select an AI platform" required error="Select an AI platform." />
  <FormField id="prompt-tags" name="prompt_tags" label="Tags" placeholder="react, frontend, web-development" hint="Separate tags with commas." />
  <FormField id="prompt-content" name="prompt_content" label="Prompt" control="textarea" rows={10} required error="Paste the prompt text." />
  <FormField id="prompt-usage" name="usage_instructions" label="Usage instructions" control="textarea" rows={4} hint="How should someone use this prompt well?" />
  <FormField id="prompt-notes" name="additional_notes" label="Anything else" control="textarea" rows={3} />

  <ActionButton type="submit" size="lg">Submit prompt</ActionButton>
  <p id="promptSubmissionResult" class="form-result" role="status" aria-live="polite"></p>
</form>

<script>
  import { setupWeb3Form } from "../../scripts/web3form";

  setupWeb3Form({
    formId: "promptSubmissionForm",
    resultId: "promptSubmissionResult",
    pendingMessage: "Submitting your prompt...",
    successMessage: "Prompt submitted. Alec reads each one before deciding whether to add it to the library.",
    errorMessage: "Your prompt did not send. Check your connection and press Submit prompt again. Your text is still in the form.",
    clearSuccessAfterMs: 12000,
  });
</script>
