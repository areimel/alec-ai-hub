---
// Fill-in-the-blanks panel for template entries. Fields are generated by
// src/scripts/template-menu.ts from @word placeholders in #promptContent.
import ActionButton from "@components/ui/ActionButton.astro";
---

<section id="templateMenu" class="dossier__template technical-panel" aria-labelledby="template-title">
  <h2 id="template-title">Template fields</h2>
  <p class="dossier__note">
    Each word starting with @ in the prompt is a blank. Fill in a field and the
    prompt text updates as you type, and the copy button copies the result.
  </p>
  <form id="templateForm" class="dossier__fields" onsubmit="return false"></form>
  <div class="dossier__template-actions">
    <ActionButton id="resetTemplateBtn" variant="outline" size="sm">Reset</ActionButton>
  </div>
</section>

<script>
  import "../../scripts/template-menu";
</script>
