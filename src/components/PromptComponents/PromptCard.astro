---
import ActionButton from "@components/ui/ActionButton.astro";
import SlugBarcode from "@components/kojima/SlugBarcode.astro";
import { directoryCollections, type DirectoryCollection } from "@lib/collections";

interface Props {
  itemEntry: {
    data: {
      category: string;
      featured: boolean;
      title: string;
      description: string;
      tags: string[];
      sub_category: string;
      version: string;
    };
    body: string;
    slug: string;
  };
  collectionType?: DirectoryCollection;
}

const { itemEntry, collectionType = "prompts" } = Astro.props;
const { data } = itemEntry;

const config = directoryCollections[collectionType];
const linkUrl = `/${config.base}/${itemEntry.slug}`;
const { viewLabel: viewText, copyLabel: copyText, subCategoryLabel } = config;
---

<article
  class="prompt-card"
  data-category={data.category}
  data-subcategory={data.sub_category}
  data-tags={JSON.stringify(data.tags)}
  data-title={data.title}
  data-description={data.description}
>
  <div class="prompt-card__meta technical-label">
    <span>{data.category}</span>
    {data.featured && <span class="prompt-card__featured">Featured</span>}
    <SlugBarcode slug={itemEntry.slug} class="prompt-card__barcode" />
  </div>

  <h2 class="prompt-card__title">{data.title}</h2>
  <p class="prompt-card__desc">{data.description}</p>

  <dl class="prompt-card__facts technical-label">
    <div><dt>{subCategoryLabel}</dt><dd>{data.sub_category}</dd></div>
    <div><dt>Version</dt><dd>{data.version}</dd></div>
  </dl>

  {
    data.tags.length > 0 && (
      <ul class="prompt-card__tags technical-label">
        {data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
      </ul>
    )
  }

  <div class="prompt-card__preview" tabindex="0" role="region" aria-label={`${data.title} text`}>
    <pre>{itemEntry.body}</pre>
  </div>

  <div class="prompt-card__actions">
    <ActionButton href={linkUrl} variant="outline">{viewText}</ActionButton>
    <ActionButton variant="default" class="copy-button">{copyText}</ActionButton>
  </div>
</article>
