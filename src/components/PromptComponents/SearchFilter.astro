---
import { Input } from "@/components/ui/input";
import FilterButton from "./FilterButton.astro";
import { directoryCollections, type DirectoryCollection } from "@lib/collections";

interface Props {
  publishedItems: any[];
  categories: string[];
  categoryCount: Record<string, number>;
  subCategories: string[];
  allTags: string[];
  collectionType?: DirectoryCollection;
}

const { publishedItems, categories, categoryCount, subCategories, allTags, collectionType = "prompts" } = Astro.props;

const { searchPlaceholder, subCategoryHeading, allSubCategoriesLabel } = directoryCollections[collectionType];
---

<div class="directory-filters">
  <button
    type="button"
    id="mobileMenuToggle"
    class="directory-filters__toggle technical-label"
    aria-expanded="false"
    aria-controls="sidebarContent"
  >
    <span>Filters</span>
    <span aria-hidden="true" class="directory-filters__chevron"></span>
  </button>

  <div id="sidebarContent" class="hidden lg:block directory-filters__body">
    <div class="directory-filters__group">
      <label for="searchInput" class="technical-label">Search</label>
      <Input type="text" id="searchInput" placeholder={searchPlaceholder} autocomplete="off" />
      <button type="button" id="resetFilters" class="directory-filters__reset technical-label">
        Reset filters
      </button>
    </div>

    <div class="directory-filters__group">
      <h2 class="technical-label">Categories</h2>
      <div class="directory-filters__list directory-filters__scroll">
        <FilterButton kind="category" value="all" label="All categories" count={publishedItems.length} active />
        {categories.map((category) => (
          <FilterButton kind="category" value={category} count={categoryCount[category]} />
        ))}
      </div>
    </div>

    <div class="directory-filters__group">
      <h2 class="technical-label">{subCategoryHeading}</h2>
      <div class="directory-filters__list">
        <FilterButton kind="subcategory" value="all" label={allSubCategoriesLabel} active />
        {subCategories.map((subCategory) => (
          <FilterButton kind="subcategory" value={subCategory} />
        ))}
      </div>
    </div>

    <div class="directory-filters__group">
      <h2 class="technical-label">Tags</h2>
      <div class="directory-filters__tags">
        {allTags.map((tag) => (
          <FilterButton kind="tag" value={tag} />
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import "../../scripts/directory/index.ts";
</script>
