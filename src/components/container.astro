---
interface Props {
  class?: string;
  width?: "default" | "full";
}

const { class: className, width = "default" } = Astro.props;
const widthClass =
  width === "full"
    ? "px-4 md:px-6 xl:px-8"
    : "mx-auto max-w-[1600px] px-5 md:px-10";
---

<div class:list={[widthClass, className]}>
  <slot />
</div>
