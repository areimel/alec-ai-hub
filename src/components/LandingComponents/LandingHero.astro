---
import Container from "@components/container.astro";
import ActionButton from "@components/ui/ActionButton.astro";
import { InstrumentGraphic } from "@/components/kojima/instrument-graphic";
import type { InstrumentGraphicProps } from "@/components/kojima/instrument-graphic";

export interface Props {
  content: {
    kicker: string;
    headline: string;
    headlineMuted: string;
    intro: string;
    primary: { text: string; href: string };
    secondary: { text: string; href: string };
  };
  /** Real figures shown in a ruled strip under the hero. */
  stats?: { label: string; value: string | number }[];
  plate: InstrumentGraphicProps;
}

const { content, stats = [], plate } = Astro.props;
---

<section class="home-hero">
  <Container>
    <div class="home-hero__top">
      <p class="kicker">{content.kicker}</p>
      <span class="registration-mark" aria-hidden="true"></span>
    </div>
    <div class="home-hero__grid">
      <div class="home-hero__copy">
        <h1>
          {content.headline}
          <span class="home-hero__muted">{content.headlineMuted}</span>
        </h1>
        <p class="home-hero__intro">{content.intro}</p>
        <div class="home-hero__actions">
          <ActionButton href={content.primary.href} size="lg">{content.primary.text}</ActionButton>
          <ActionButton href={content.secondary.href} variant="outline" size="lg">
            {content.secondary.text}
          </ActionButton>
        </div>
      </div>
      <div class="home-hero__plate">
        <InstrumentGraphic {...plate} decorative />
      </div>
    </div>
    {
      stats.length > 0 && (
        <dl class="stat-strip">
          {stats.map(({ label, value }) => (
            <div>
              <dt class="technical-label">{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </Container>
</section>
