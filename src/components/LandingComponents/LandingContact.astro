---
import SectionHead from "@components/SectionHead.astro";
import Container from "@components/container.astro";
import ContactForm from "@components/FormComponents/contactform.astro";
import { FaqAccordion } from "./FaqAccordion";

export interface Props {
  faq: {
    header: { label: string; title: string };
    items: { id: string; question: string; answer: string }[];
  };
  contact: {
    header: { label: string; title: string; description: string };
    /** Passed to ContactForm; omitted on the homepage. */
    subject?: string;
    interest?: { label: string; options: string[] };
  };
}

const { faq, contact } = Astro.props;
---

<section class="home-section">
  <Container>
    <div class="faq-contact">
      <div>
        <SectionHead label={faq.header.label} title={faq.header.title} />
        <FaqAccordion items={faq.items} client:visible />
      </div>
      <div id="contact" class="technical-panel faq-contact__form scroll-mt-24">
        <SectionHead label={contact.header.label} title={contact.header.title} />
        <p class="faq-contact__intro">{contact.header.description}</p>
        <ContactForm subject={contact.subject} interest={contact.interest} />
      </div>
    </div>
  </Container>
</section>
