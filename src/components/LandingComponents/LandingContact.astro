---
import Container from "@components/container.astro";
import ContactForm from "@components/FormComponents/contactform.astro";
import { FaqAccordion } from "./FaqAccordion";

export interface Props {
  faq: {
    header: { label: string; title: string };
    items: { id: string; question: string; answer: string }[];
  };
  contact: {
    header: { label: string; title: string; description: string };
  };
}

const { faq, contact } = Astro.props;
---

<section class="home-section">
  <Container>
    <div class="faq-contact">
      <div>
        <p class="kicker">{faq.header.label}</p>
        <h2 class="home-section__title">{faq.header.title}</h2>
        <FaqAccordion items={faq.items} client:visible />
      </div>
      <div class="technical-panel faq-contact__form">
        <p class="kicker">{contact.header.label}</p>
        <h2 class="home-section__title">{contact.header.title}</h2>
        <p class="faq-contact__intro">{contact.header.description}</p>
        <ContactForm />
      </div>
    </div>
  </Container>
</section>
