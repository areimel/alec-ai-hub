---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHeader from "@components/PageHeader.astro";
import PromptDirectoryGroup from "@components/PromptComponents/PromptDirectoryGroup.astro";

---

<Layout title="Custom Agents">
  <PageHeader
    label="Directory / Custom Agents"
    title="Custom Agents"
    intro={"Agent files you can save into your own project. Filter by category or access, then copy one or open it to read the full file."}
    width="full"
  />
  <Container width="full">
    <PromptDirectoryGroup collectionType="agents" />
  </Container>
</Layout>
