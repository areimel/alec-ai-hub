---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHeader from "@components/PageHeader.astro";
import PromptDirectoryGroup from "@components/PromptComponents/PromptDirectoryGroup.astro";
import { getPublished } from "@lib/content";

const count = (await getPublished("prompts")).length;
---

<Layout title="Prompts">
  <PageHeader
    label="Directory / Prompts"
    title="Prompts"
    intro={`${count} prompts I use and keep up to date. Filter by category or tool, then copy one or open it to fill in the blanks.`}
  />
  <Container>
    <PromptDirectoryGroup />
  </Container>
</Layout>
