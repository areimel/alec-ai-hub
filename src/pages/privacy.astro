---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHeader from "@components/PageHeader.astro";
---

<Layout title="Privacy Policy">
  <PageHeader label="Legal / Privacy" title="Privacy Policy" />
  <Container>
    <div class="prose py-12">
      <p>
        <strong>Last updated: November 4, 2026.</strong> AI Hub is a personal, non-commercial site run by Alec Reimel. This policy explains what data it handles.
      </p>

      <section>
        <h2>1. What the site collects</h2>
        <ul>
          <li><strong>Form submissions:</strong> your name, email address and whatever you write in the contact or prompt submission form. You only share this if you send a form.</li>
          <li><strong>Usage data:</strong> Google Analytics records things like the pages you visit, your browser and device type, and your approximate location. It uses cookies to do this.</li>
          <li><strong>Your theme choice:</strong> your light or dark setting is saved in your browser and isn't sent to me.</li>
        </ul>
      </section>

      <section>
        <h2>2. How it's used</h2>
        <ul>
          <li>To read and reply to your message, and to review prompts you submit. If I publish a prompt you submitted, I may edit it.</li>
          <li>To understand how the site is used and improve it.</li>
        </ul>
        <p>
          The site has no accounts, payments, ads or newsletter, and I don't sell your personal information.
        </p>
      </section>

      <section>
        <h2>3. Services that handle this data</h2>
        <ul>
          <li><strong>Web3Forms</strong> delivers form submissions to my inbox. <a href="https://web3forms.com/privacy">Web3Forms privacy policy</a></li>
          <li><strong>Google Tag Manager and Google Analytics</strong> provide usage statistics. <a href="https://policies.google.com/privacy">Google privacy policy</a></li>
          <li><strong>GitHub Pages</strong> hosts the site and may log technical data such as IP addresses. <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub privacy statement</a></li>
        </ul>
      </section>

      <section>
        <h2>4. How long it's kept</h2>
        <p>
          Form submissions stay in my inbox until I no longer need them or you ask me to delete them. Google Analytics data is kept according to its retention settings.
        </p>
      </section>

      <section>
        <h2>5. Your choices</h2>
        <ul>
          <li>Ask to see or delete the form submissions I hold from you, using the <a href="/#contact">contact form</a>.</li>
          <li>Block or delete cookies in your browser, or use Google's <a href="https://tools.google.com/dlpage/gaoptout">Analytics opt-out add-on</a>.</li>
        </ul>
      </section>

      <section>
        <h2>6. Changes</h2>
        <p>
          If this policy changes, I'll update it here and change the date above.
        </p>
      </section>
    </div>
  </Container>
</Layout>
