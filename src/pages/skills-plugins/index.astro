---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHeader from "@components/PageHeader.astro";
import PromptDirectoryGroup from "@components/PromptComponents/PromptDirectoryGroup.astro";
import { getPublished } from "@lib/content";

const count = (await getPublished("skills")).length;
---

<Layout title="Skills & Plugins">
  <PageHeader
    label="Directory / Skills & Plugins"
    title="Skills & Plugins"
    intro={`${count} skill and plugin files you can save into your own project. Filter by category or type, then copy one or open it to read the full file.`}
  />
  <Container>
    <PromptDirectoryGroup collectionType="skills" />
  </Container>
</Layout>
