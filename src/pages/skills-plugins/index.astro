---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHeader from "@components/PageHeader.astro";
import PromptDirectoryGroup from "@components/PromptComponents/PromptDirectoryGroup.astro";

---

<Layout title="Skills & Plugins">
  <PageHeader
    label="Directory / Skills & Plugins"
    title="Skills & Plugins"
    intro={"Skill and plugin files you can save into your own project. Filter by category or type, then copy one or open it to read the full file."}
    width="full"
  />
  <Container width="full">
    <PromptDirectoryGroup collectionType="skills" />
  </Container>
</Layout>
