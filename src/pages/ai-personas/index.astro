---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHeader from "@components/PageHeader.astro";
import PromptDirectoryGroup from "@components/PromptComponents/PromptDirectoryGroup.astro";
import { getPublished } from "@lib/content";

const count = (await getPublished("personas")).length;
---

<Layout title="Personas">
  <PageHeader
    label="Directory / Personas"
    title="Personas"
    intro={`${count} personas that set up an AI for a role. Filter by category or type, then copy one or open it to read the full text.`}
  />
  <Container>
    <PromptDirectoryGroup collectionType="personas" />
  </Container>
</Layout>
