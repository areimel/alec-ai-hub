---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHeader from "@components/PageHeader.astro";
import EntryRegister from "@components/EntryRegister.astro";
import { getPublished } from "@/lib/content";

const posts = await getPublished("blog");
const entries = posts.map((post) => ({
  href: `/blog/${post.slug}`,
  date: post.data.publishDate,
  category: post.data.category,
  title: post.data.title,
  snippet: post.data.snippet,
}));
---

<Layout title="Blog">
  <PageHeader
    label="News & Tips / Field notes"
    title="News & Tips"
    intro="Updates on new features, plus practical notes on prompt writing and getting more from AI tools."
  />
  <Container class="blog-section">
    {
      entries.length === 0 ? (
        <p class="blog-empty">No posts yet.</p>
      ) : (
        <EntryRegister entries={entries} />
      )
    }
  </Container>
</Layout>
