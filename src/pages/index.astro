---
import SectionHead from "@components/SectionHead.astro";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import EntryRegister from "@components/EntryRegister.astro";
import PlateLink from "@/components/kojima/PlateLink.astro";
import LandingHero from "@components/LandingComponents/LandingHero.astro";
import LandingFeatures from "@components/LandingComponents/LandingFeatures.astro";
import LandingPanel from "@components/LandingComponents/LandingPanel.astro";
import LandingContact from "@components/LandingComponents/LandingContact.astro";
import { getPublished } from "@/lib/content";
import homeContent from "@data/homeContent.json";

const [prompts, agents, skills] = await Promise.all([
  getPublished("prompts"),
  getPublished("agents"),
  getPublished("skills"),
]);

const latest = [
  ...prompts.map((e) => ({ ...e, base: "prompts" })),
  ...agents.map((e) => ({ ...e, base: "custom-agents" })),
  ...skills.map((e) => ({ ...e, base: "skills-plugins" })),
]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6)
  .map((e) => ({
    href: `/${e.base}/${e.slug}`,
    date: e.data.publishDate,
    category: e.data.category,
    title: e.data.title,
  }));

const { plates } = homeContent;
---

<Layout>
  <LandingHero
    content={homeContent.hero}
    plate={{
      variant: "radar",
      palette: "orange",
      seed: 25,
      code: "INDEX",
      plate: "AI HUB",
      footerLines: ["PROMPT + AGENT + SKILL", "ALEC REIMEL"],
    }}
  />

  <section class="home-section">
    <Container>
      <div class="plate-row">
        <PlateLink
          href="/prompts"
          title={plates.prompts.title}
          description={plates.prompts.description}
          variant="radar"
          palette="paper"
          seed={7}
          wordmark="PROMPTS"
          code="PROMPTS"
          plate="PROMPTS"
          footerLines={["WORKING FILES", "ALEC REIMEL"]}
        />
        <PlateLink
          href="/custom-agents"
          title={plates.agents.title}
          description={plates.agents.description}
          variant="grid"
          palette="dark"
          seed={11}
          wordmark="AGENTS"
          code="AGENTS"
          plate="CUSTOM AGENTS"
          footerLines={["WORKING FILES", "ALEC REIMEL"]}
        />
        <PlateLink
          href="/skills-plugins"
          title={plates.skills.title}
          description={plates.skills.description}
          variant="wave"
          palette="orange"
          seed={13}
          wordmark="SKILLS"
          code="SKILLS"
          plate="SKILLS & PLUGINS"
          footerLines={["WORKING FILES", "ALEC REIMEL"]}
        />
      </div>
    </Container>
  </section>

  <section class="home-section">
    <Container>
      <SectionHead label={homeContent.latest.label} title={homeContent.latest.title} />
      <EntryRegister entries={latest} />
    </Container>
  </section>

  <LandingFeatures content={homeContent.features} />

  <LandingPanel
    content={homeContent.about}
    plate={{
      variant: "wave",
      palette: "paper",
      seed: 3,
      wordmark: "ALEC",
      code: "ABOUT",
      plate: "ABOUT",
      footerLines: ["ALEC REIMEL", "AI HUB"],
      idSuffix: "about",
    }}
  />

  <LandingContact faq={homeContent.faq} contact={homeContent.contact} />
</Layout>
