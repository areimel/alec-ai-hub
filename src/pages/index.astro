---
import SectionHead from "@components/SectionHead.astro";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import EntryRegister from "@components/EntryRegister.astro";
import PlateLink from "@/components/kojima/PlateLink.astro";
import LandingHero from "@components/LandingComponents/LandingHero.astro";
import LandingFeatures from "@components/LandingComponents/LandingFeatures.astro";
import LandingPanel from "@components/LandingComponents/LandingPanel.astro";
import LandingContact from "@components/LandingComponents/LandingContact.astro";
import { getCounts, getPublished } from "@/lib/content";
import homeContent from "@data/homeContent.json";

const [counts, prompts, personas, posts] = await Promise.all([
  getCounts(),
  getPublished("prompts"),
  getPublished("agents"),
  getPublished("blog"),
]);

const latest = [
  ...prompts.map((e) => ({ ...e, base: "prompts" })),
  ...personas.map((e) => ({ ...e, base: "custom-agents" })),
  ...posts.map((e) => ({ ...e, base: "blog" })),
]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6)
  .map((e) => ({
    href: `/${e.base}/${e.slug}`,
    date: e.data.publishDate,
    category: e.data.category,
    title: e.data.title,
  }));

const stats = [
  { label: "Prompts", value: counts.prompts },
  { label: "AI personas", value: counts.agents },
  { label: "News & tips", value: counts.blog },
];
const { plates } = homeContent;
---

<Layout>
  <LandingHero
    content={homeContent.hero}
    stats={stats}
    plate={{
      variant: "radar",
      palette: "orange",
      seed: 25,
      code: `PROMPTS—${counts.prompts}`,
      plate: "AI HUB",
      footerLines: [`${counts.prompts} PROMPTS PUBLISHED`, "ALEC REIMEL"],
    }}
  />

  <section class="home-section">
    <Container>
      <div class="plate-row">
        <PlateLink
          href="/prompts"
          title={plates.prompts.title}
          description={plates.prompts.description}
          meta={`${counts.prompts} prompts`}
          variant="radar"
          palette="paper"
          seed={7}
          wordmark="PROMPTS"
          code={`PROMPTS—${counts.prompts}`}
          plate="PROMPTS"
          footerLines={[`${counts.prompts} PUBLISHED`, "ALEC REIMEL"]}
        />
        <PlateLink
          href="/custom-agents"
          title={plates.personas.title}
          description={plates.personas.description}
          meta={`${counts.agents} personas`}
          variant="grid"
          palette="dark"
          seed={11}
          wordmark="PERSONAS"
          code={`PERSONAS—${counts.agents}`}
          plate="PERSONAS"
          footerLines={[`${counts.agents} PUBLISHED`, "ALEC REIMEL"]}
        />
        <PlateLink
          href="/blog"
          title={plates.blog.title}
          description={plates.blog.description}
          meta={`${counts.blog} posts`}
          variant="wave"
          palette="orange"
          seed={13}
          wordmark="NOTES"
          code={`NOTES—${counts.blog}`}
          plate="NEWS & TIPS"
          footerLines={[`${counts.blog} PUBLISHED`, "ALEC REIMEL"]}
        />
      </div>
    </Container>
  </section>

  <section class="home-section">
    <Container>
      <SectionHead label={homeContent.latest.label} title={homeContent.latest.title} />
      <EntryRegister entries={latest} />
    </Container>
  </section>

  <LandingFeatures content={homeContent.features} />

  <LandingPanel
    content={homeContent.about}
    plate={{
      variant: "wave",
      palette: "paper",
      seed: 3,
      wordmark: "ALEC",
      code: "ABOUT",
      plate: "ABOUT",
      footerLines: ["ALEC REIMEL", "AI HUB"],
      idSuffix: "about",
    }}
  />

  <LandingContact faq={homeContent.faq} contact={homeContent.contact} />
</Layout>
