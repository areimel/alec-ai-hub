---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHeader from "@components/PageHeader.astro";
import PromptSubmissionForm from "@components/FormComponents/PromptSubmissionForm.astro";

const pageTitle = "Submit a Prompt";
const pageDescription =
  "Send Alec a prompt that works for you. He reviews each submission before anything is added to the library.";
---

<Layout title={pageTitle} description={pageDescription}>
  <PageHeader
    label="Contribute / Prompts"
    title="Submit a prompt"
    intro="Have a prompt that works well? Send it to me. I read every submission and decide whether it belongs in the library."
  />
  <Container class="submit-layout">
    <aside class="submit-guidelines">
      <p class="technical-label">Before you send</p>
      <ul>
        <li>Use a prompt you have actually tried.</li>
        <li>Say what it does and how to use it.</li>
        <li>Pick the closest category and AI platform.</li>
        <li>Send only prompts that are yours or that you have permission to share.</li>
      </ul>
    </aside>
    <PromptSubmissionForm />
  </Container>
</Layout>
