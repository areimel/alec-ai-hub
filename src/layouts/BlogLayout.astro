---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import Container from "@components/container.astro";
import { getFormattedDate } from "@utils/all";
import Layout from "./Layout.astro";

interface Props {
  frontmatter: CollectionEntry<"blog">["data"];
}

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <Container class="blog-post">
    <header class="post-header">
      <a class="post-back" href="/blog">← All posts</a>
      <p class="kicker">{frontmatter.category}</p>
      <h1>{frontmatter.title}</h1>
      <p class="technical-label post-meta">
        <span>{frontmatter.author}</span>
        <time datetime={frontmatter.publishDate.toISOString()}>
          {getFormattedDate(frontmatter.publishDate)}
        </time>
      </p>
      {
        frontmatter.tags.length > 0 && (
          <ul class="post-tags">
            {frontmatter.tags.map((tag) => (
              <li class="technical-label">#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      frontmatter.image && (
        <figure class="post-figure">
          <Picture
            src={frontmatter.image.src}
            alt={frontmatter.image.alt}
            sizes="(max-width: 768px) 100vw, 70ch"
            width={800}
            height={600}
            loading="eager"
            decoding="async"
          />
        </figure>
      )
    }

    <div class="prose post-body">
      <slot />
    </div>
  </Container>
</Layout>
