---
import { SEO } from "astro-seo";
import { Navbar } from "@/components/blocks/navbar";
import { Footer } from "@/components/blocks/footer";
import AnnouncementBanner from "@components/AnnouncementBanner.astro";
import "../styles/global.css";
import branding from "@data/branding.json";

export interface Props {
  title?: string;
  description?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedImageWithDomain = new URL("/opengraph.jpg", Astro.site).toString();

const { title, description } = Astro.props;

const makeTitle = title
  ? title + " | " + branding.site.name
  : branding.seo.title;
---

<!doctype html>
<html lang="en" data-theme="kojima" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- No-flash theme: dark by default, saved choice wins, storage may be blocked -->
    <script is:inline>
      (() => {
        const apply = (value) => {
          const theme = value === "light" ? "light" : "dark";
          document.documentElement.classList.toggle("dark", theme === "dark");
          document.documentElement.style.colorScheme = theme;
        };
        const restore = () => {
          let saved = null;
          try {
            saved = localStorage.getItem("theme");
          } catch {
            /* Default to dark if storage is unavailable. */
          }
          apply(saved);
        };
        restore();
        window.addEventListener("storage", (event) => {
          if (event.key === "theme" || event.key === null) restore();
        });
      })();
    </script>
    <link
      rel="preload"
      href="/fonts/dm-sans/DMSans-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />

    <!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-TVLFMZ8F');</script>
  <!-- End Google Tag Manager -->

    <SEO
      title={makeTitle}
      description={description ?? branding.seo.description}
      canonical={canonicalURL}
      twitter={{ card: "summary_large_image" }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: branding.seo.openGraph.title,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: branding.seo.openGraph.image.alt,
        },
      }}
    />
  </head>
  <body class="bg-background text-foreground min-h-screen antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TVLFMZ8F"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a href="#main-content" class="skip-link">Skip to main content</a>
    <AnnouncementBanner />
    <Navbar client:load pathname={Astro.url.pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
